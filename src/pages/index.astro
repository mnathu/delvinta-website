---
import Layout from '~/layouts/Layout.astro';
import '~/styles/delvinta.css';

const solutions = [
  {
    number: '01',
    title: 'Healthcare Integration',
    description:
      'Connect EHRs, clinical applications, interfaces, and downstream systems with integration architecture designed around real healthcare workflows.',
  },
  {
    number: '02',
    title: 'Diagnostic Systems',
    description:
      'Bring laboratory information systems, analyzers, instruments, and diagnostic platforms together with dependable connectivity and operational visibility.',
  },
  {
    number: '03',
    title: 'Integration Intelligence',
    description:
      'Turn interface activity and operational signals into actionable insight so support teams can identify problems faster and keep clinical systems moving.',
  },
];

const services = [
  {
    title: 'Consulting',
    description:
      'Specialized expertise for healthcare interoperability, LIS/LIMS, medical device integration, and complex interface environments.',
  },
  {
    title: 'Managed Integration',
    description:
      'Ongoing monitoring, troubleshooting, optimization, and operational support for critical integration environments.',
  },
  {
    title: 'Implementation & Optimization',
    description:
      'From new interfaces to system modernization, improve reliability, performance, and the experience of the teams who support them.',
  },
];

const industries = ['Health Systems', 'Clinical Laboratories', 'Diagnostic Networks'];
---

<Layout>
  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden bg-white">
      <div class="absolute inset-0 delvinta-grid opacity-70"></div>

      <div class="delvinta-container relative">
        <div class="grid min-h-[720px] items-center gap-14 py-24 lg:grid-cols-[1fr_0.9fr] lg:py-28">
          <div>
            <div class="delvinta-eyebrow">Healthcare Integration Technology</div>

            <h1 class="delvinta-heading">
              Healthcare integration,
              <span class="text-[var(--delvinta-blue)]">engineered for what's next.</span>
            </h1>

            <p class="delvinta-body mt-7">
              DELVINTA Technologies helps health systems connect, monitor, and optimize the clinical and diagnostic
              systems that keep patient care moving.
            </p>

            <div class="mt-9 flex flex-wrap gap-3">
              <a href="/services" class="delvinta-button delvinta-button-primary">
                Explore Solutions
                <span class="ml-2" aria-hidden="true">→</span>
              </a>

              <a href="/contact" class="delvinta-button delvinta-button-secondary"> Let's Talk </a>
            </div>

            <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 text-sm text-[var(--delvinta-slate)]">
              <span>Epic &amp; LIS</span>
              <span>Medical Devices</span>
              <span>HL7 Integration</span>
              <span>Diagnostic Systems</span>
            </div>
          </div>

          <div class="delvinta-network shadow-2xl shadow-slate-300/20">
            <div class="absolute left-7 top-7 z-10">
              <div class="delvinta-kicker">Integration Network</div>
              <div class="mt-2 text-sm text-white/70">Systems connected. Data moving.</div>
            </div>

            <div class="delvinta-line delvinta-line-v delvinta-line-v-top"></div>
            <div class="delvinta-line delvinta-line-v delvinta-line-v-bottom"></div>
            <div class="delvinta-line delvinta-line-h delvinta-line-h-left"></div>
            <div class="delvinta-line delvinta-line-h delvinta-line-h-right"></div>

            <div class="delvinta-node delvinta-node-top">EHR / Epic</div>
            <div class="delvinta-node delvinta-node-left">Laboratory</div>

            <div class="delvinta-node delvinta-node-center">
              <div class="text-center">
                <div class="text-xs font-medium uppercase tracking-[0.18em] text-cyan-200">DELVINTA</div>
                <div class="mt-1 text-base font-semibold">Integration</div>
              </div>
            </div>

            <div class="delvinta-node delvinta-node-right">Medical Devices</div>
            <div class="delvinta-node delvinta-node-bottom">Clinical Data</div>
          </div>
        </div>
      </div>
    </section>

    <!-- POSITIONING -->
    <section class="delvinta-section border-y border-[var(--delvinta-border)] bg-[var(--delvinta-light)]">
      <div class="delvinta-container">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
          <div>
            <div class="delvinta-eyebrow">Built Around the Workflow</div>

            <h2 class="delvinta-heading-small">Integration is infrastructure for patient care.</h2>
          </div>

          <div>
            <p class="delvinta-body">
              Healthcare organizations depend on a web of systems that must communicate reliably every minute of every
              day. DELVINTA focuses on the layer where those systems meet—making complex integration environments easier
              to implement, support, monitor, and improve.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SOLUTIONS -->
    <section class="delvinta-section">
      <div class="delvinta-container">
        <div class="max-w-3xl">
          <div class="delvinta-eyebrow">Solutions</div>

          <h2 class="delvinta-heading-small">Specialized technology for connected healthcare.</h2>

          <p class="delvinta-body mt-6">
            Practical solutions for the systems, interfaces, and operational challenges behind modern clinical
            environments.
          </p>
        </div>

        <div class="mt-14 grid gap-5 md:grid-cols-3">
          {
            solutions.map((solution) => (
              <article class="delvinta-card">
                <div class="text-xs font-bold tracking-[0.15em] text-[var(--delvinta-cyan)]">{solution.number}</div>

                <h3 class="mt-8 text-xl font-semibold tracking-tight text-[var(--delvinta-navy)]">{solution.title}</h3>

                <p class="mt-4 text-sm leading-7 text-[var(--delvinta-slate)]">{solution.description}</p>

                <a
                  href="/services"
                  class="mt-7 inline-flex items-center text-sm font-semibold text-[var(--delvinta-blue)]"
                >
                  Learn more
                  <span class="ml-2" aria-hidden="true">
                    →
                  </span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="delvinta-section bg-[var(--delvinta-navy-deep)] text-white">
      <div class="delvinta-container">
        <div class="grid gap-14 lg:grid-cols-[0.75fr_1.25fr]">
          <div>
            <div class="delvinta-eyebrow text-cyan-300">Services</div>

            <h2 class="max-w-xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
              Expertise where healthcare technology gets complicated.
            </h2>

            <p class="mt-6 max-w-lg text-base leading-7 text-white/65">
              DELVINTA brings hands-on integration experience to environments where reliability, interoperability, and
              operational knowledge matter.
            </p>
          </div>

          <div class="grid gap-4">
            {
              services.map((service, index) => (
                <article class="grid gap-5 rounded-xl border border-white/10 bg-white/[0.035] p-7 transition hover:border-cyan-300/30 hover:bg-white/[0.055] sm:grid-cols-[70px_1fr]">
                  <div class="text-sm font-semibold text-cyan-300">0{index + 1}</div>

                  <div>
                    <h3 class="text-xl font-semibold">{service.title}</h3>
                    <p class="mt-3 max-w-2xl text-sm leading-7 text-white/60">{service.description}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- INDUSTRIES -->
    <section class="delvinta-section">
      <div class="delvinta-container">
        <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-end">
          <div>
            <div class="delvinta-eyebrow">Industries</div>

            <h2 class="delvinta-heading-small">Deep experience in the environments we serve.</h2>
          </div>

          <p class="delvinta-body lg:ml-auto">
            Our focus is healthcare technology where systems, devices, data, and people have to work together without
            compromise.
          </p>
        </div>

        <div class="mt-12 grid border-y border-[var(--delvinta-border)] sm:grid-cols-3">
          {
            industries.map((industry, index) => (
              <div
                class:list={[
                  'px-6 py-8 sm:px-8',
                  index !== 0 && 'border-t sm:border-l sm:border-t-0 border-[var(--delvinta-border)]',
                ]}
              >
                <div class="text-xs font-bold tracking-[0.15em] text-[var(--delvinta-cyan)]">0{index + 1}</div>

                <h3 class="mt-5 text-lg font-semibold text-[var(--delvinta-navy)]">{industry}</h3>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="pb-24">
      <div class="delvinta-container">
        <div class="delvinta-cta px-8 py-14 sm:px-12 sm:py-16">
          <div class="relative z-10 max-w-3xl">
            <div class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-300">Start a Conversation</div>

            <h2 class="mt-5 text-3xl font-bold tracking-tight sm:text-5xl">
              Let's make healthcare systems work better together.
            </h2>

            <p class="mt-5 max-w-2xl text-base leading-7 text-white/65">
              Whether you're solving an integration challenge, modernizing a diagnostic environment, or planning what's
              next, let's talk.
            </p>

            <a
              href="/contact"
              class="mt-8 inline-flex items-center rounded-lg bg-white px-6 py-3 text-sm font-semibold text-[var(--delvinta-navy)] transition hover:-translate-y-0.5"
            >
              Let's Talk
              <span class="ml-2" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>n
