---
import Layout from '~/layouts/Layout.astro';
import '~/styles/delvinta.css';

const integrationCapabilities = [
  {
    title: 'EPIC BEAKER',
    items: 'Implementation · Conversion · Testing · Go-Live',
  },
  {
    title: 'INTEGRATION',
    items: 'Data Innovations · Instruments · Middleware · Automation',
  },
  {
    title: 'OPTIMIZATION',
    items: 'Support · Quality Control · Autoverification · Monitoring',
  },
];

const lifecycle = ['Plan', 'Build', 'Integrate', 'Test', 'Go-Live', 'Stabilize', 'Support', 'Optimize'];

const integrationLayer = ['Epic Beaker', 'Data Innovations', 'Instruments', 'Middleware', 'Automation'];
---

<Layout>
  <!-- HERO -->
  <section class="delvinta-section relative overflow-hidden">
    <div class="delvinta-container">
      <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
        <div>
          <p class="delvinta-eyebrow">Laboratory Integration &amp; Transformation</p>

          <h1 class="delvinta-heading mt-5 max-w-3xl">
            Transforming the laboratory.
            <span class="delvinta-heading-subtitle block"> Delivering integration solutions. </span>
          </h1>

          <p class="delvinta-body mt-6 max-w-2xl">
            Specialized integration expertise for Epic Beaker, Data Innovations Instrument Manager, diagnostic
            instruments, middleware, and laboratory automation.
          </p>

          <div class="mt-8">
            <a href="#contact" class="delvinta-button delvinta-button-primary"> Talk to DELVINTA </a>
          </div>
        </div>

        <!-- Integration Architecture -->
        <div class="delvinta-network min-h-[360px]">
          <div class="delvinta-node delvinta-node-laboratory">Laboratory</div>

          <div class="delvinta-node delvinta-node-delvinta">DELVINTA Integration</div>

          <div class="delvinta-node delvinta-node-data">Data Innovations</div>

          <div class="delvinta-node delvinta-node-epic">Epic Beaker</div>

          <div class="delvinta-node delvinta-node-instruments">Instruments &amp; Automation</div>

          <div class="delvinta-line delvinta-line-main"></div>
          <div class="delvinta-line delvinta-line-epic"></div>
          <div class="delvinta-line delvinta-line-instruments"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- LABORATORY INTEGRATION -->
  <section class="delvinta-section bg-[var(--delvinta-light)]">
    <div class="delvinta-container">
      <div class="max-w-3xl">
        <p class="delvinta-eyebrow">Laboratory Integration</p>

        <h2 class="delvinta-heading-small mt-3">From implementation to optimization.</h2>

        <p class="delvinta-body mt-5">
          DELVINTA connects the systems, instruments, and workflows that keep the laboratory moving.
        </p>
      </div>

      <!-- Compact capability rows -->
      <div class="mt-10 border-t border-[var(--delvinta-border)]">
        {
          integrationCapabilities.map((capability) => (
            <div class="grid gap-2 border-b border-[var(--delvinta-border)] py-5 sm:grid-cols-[180px_1fr] sm:items-center sm:gap-8">
              <h3 class="text-sm font-bold tracking-widest text-[var(--delvinta-navy)]">{capability.title}</h3>

              <p class="text-sm leading-6 text-[var(--delvinta-slate)]">{capability.items}</p>
            </div>
          ))
        }
      </div>

      <!-- Integration lifecycle -->
      <div class="mt-8">
        <p class="text-xs font-semibold tracking-widest text-[var(--delvinta-teal)]">INTEGRATION LIFECYCLE</p>

        <p class="mt-3 text-sm font-medium tracking-wide text-[var(--delvinta-slate)]">
          {lifecycle.join(' → ')}
        </p>
      </div>
    </div>
  </section>

  <!-- TECHNICAL CENTERPIECE -->
  <section class="relative overflow-hidden bg-[var(--delvinta-navy-deep)] py-20 text-white sm:py-24">
    <div class="delvinta-container">
      <div class="max-w-4xl">
        <p class="delvinta-eyebrow text-[var(--delvinta-cyan)]">DELVINTA Integration</p>

        <h2 class="mt-4 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">
          Connecting the laboratory to the systems that power it.
        </h2>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
          From implementation and integration through stabilization and optimization, we bring together laboratory
          workflows, instruments, middleware, automation, and clinical systems through disciplined technical expertise.
        </p>

        <!-- Capability line -->
        <div class="mt-10 border-t border-white/10 pt-6">
          <p class="text-xs font-semibold tracking-widest text-[var(--delvinta-cyan)]">CONNECTED TECHNOLOGY</p>

          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-3 text-sm font-medium text-slate-200">
            {
              integrationLayer.map((item, index) => (
                <>
                  <span>{item}</span>
                  {index < integrationLayer.length - 1 && (
                    <span class="text-white/25" aria-hidden="true">
                      ·
                    </span>
                  )}
                </>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" class="delvinta-section">
    <div class="delvinta-container">
      <div class="mx-auto max-w-3xl text-center">
        <p class="delvinta-eyebrow">Let's Talk</p>

        <h2 class="delvinta-heading-small mt-3">Have a laboratory integration challenge?</h2>

        <p class="delvinta-body mt-5">Implementation. Integration. Support. Optimization.</p>

        <div class="mt-8">
          <a href="mailto:hello@delvinta.com" class="delvinta-button delvinta-button-primary"> Talk to DELVINTA </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
