---
import Layout from '~/layouts/Layout.astro';
---

<Layout
  metadata={{
    title: 'Capabilities | DELVINTA Technologies',
    description:
      'DELVINTA provides specialized laboratory integration solutions across Epic Beaker, Data Innovations, diagnostic instruments, middleware, automation, quality control, and laboratory optimization.',
  }}
>
  <!-- HERO -->
  <section class="delvinta-section pt-16 md:pt-24">
    <div class="delvinta-container">
      <div class="max-w-4xl">
        <div class="delvinta-eyebrow">Capabilities</div>

        <h1 class="delvinta-heading mt-6">
          Laboratory integration,
          <span class="delvinta-heading-subtitle block">from implementation to optimization.</span>
        </h1>

        <p class="delvinta-body mt-7">
          DELVINTA helps laboratories connect clinical systems, middleware, instruments, automation, and workflows
          throughout the implementation lifecycle.
        </p>
      </div>
    </div>
  </section>

  <!-- CORE CAPABILITIES -->
  <section class="pb-20 md:pb-24">
    <div class="delvinta-container">
      <div class="grid gap-5 md:grid-cols-3">
        <!-- Epic Beaker -->
        <article class="delvinta-card">
          <div class="delvinta-eyebrow mb-5">Clinical System</div>

          <h2 class="text-2xl font-bold tracking-tight text-[var(--delvinta-navy)]">Epic Beaker</h2>

          <p class="mt-4 text-sm leading-7 text-[var(--delvinta-slate)]">
            Supporting laboratory teams through implementation, conversion, testing, go-live, and stabilization.
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            <span class="delvinta-capability-tag">Implementation</span>
            <span class="delvinta-capability-tag">Conversion</span>
            <span class="delvinta-capability-tag">Testing</span>
            <span class="delvinta-capability-tag">Go-Live</span>
          </div>
        </article>

        <!-- Integration -->
        <article class="delvinta-card">
          <div class="delvinta-eyebrow mb-5">Integration</div>

          <h2 class="text-2xl font-bold tracking-tight text-[var(--delvinta-navy)]">Connected Systems</h2>

          <p class="mt-4 text-sm leading-7 text-[var(--delvinta-slate)]">
            Connecting laboratory instruments and automation through Data Innovations, middleware, and interface
            technologies.
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            <span class="delvinta-capability-tag">Data Innovations</span>
            <span class="delvinta-capability-tag">Instruments</span>
            <span class="delvinta-capability-tag">Middleware</span>
            <span class="delvinta-capability-tag">Automation</span>
          </div>
        </article>

        <!-- Optimization -->
        <article class="delvinta-card">
          <div class="delvinta-eyebrow mb-5">Optimization</div>

          <h2 class="text-2xl font-bold tracking-tight text-[var(--delvinta-navy)]">Laboratory Performance</h2>

          <p class="mt-4 text-sm leading-7 text-[var(--delvinta-slate)]">
            Improving interface reliability, laboratory workflows, staff efficiency, and ongoing system performance.
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            <span class="delvinta-capability-tag">Support</span>
            <span class="delvinta-capability-tag">Quality Control</span>
            <span class="delvinta-capability-tag">Autoverification</span>
            <span class="delvinta-capability-tag">Monitoring</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION LIFECYCLE -->
  <section class="delvinta-section bg-[var(--delvinta-light)]">
    <div class="delvinta-container">
      <div class="max-w-3xl">
        <div class="delvinta-eyebrow">Implementation Lifecycle</div>

        <h2 class="delvinta-heading-small mt-4">One integration partner across the lifecycle.</h2>

        <p class="delvinta-body mt-5">
          DELVINTA can support laboratory teams from initial planning through implementation, stabilization, and
          long-term optimization.
        </p>
      </div>

      <div class="mt-12 overflow-x-auto pb-3">
        <div class="flex min-w-max items-center gap-4 text-sm font-medium">
          <span class="rounded-full bg-white px-4 py-2 text-[var(--delvinta-navy)] shadow-sm">Plan</span>

          <span class="text-[var(--delvinta-cyan)]">→</span>

          <span class="text-[var(--delvinta-slate)]">Build</span>

          <span class="text-[var(--delvinta-cyan)]">→</span>

          <span class="text-[var(--delvinta-slate)]">Integrate</span>

          <span class="text-[var(--delvinta-cyan)]">→</span>

          <span class="text-[var(--delvinta-slate)]">Test</span>

          <span class="text-[var(--delvinta-cyan)]">→</span>

          <span class="text-[var(--delvinta-slate)]">Go-Live</span>

          <span class="text-[var(--delvinta-cyan)]">→</span>

          <span class="text-[var(--delvinta-slate)]">Stabilize</span>

          <span class="text-[var(--delvinta-cyan)]">→</span>

          <span class="text-[var(--delvinta-slate)]">Support</span>

          <span class="text-[var(--delvinta-cyan)]">→</span>

          <span class="rounded-full bg-[var(--delvinta-navy)] px-4 py-2 text-white">Optimize</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SPECIALIZED INTEGRATION -->
  <section class="delvinta-section">
    <div class="delvinta-container">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-20">
        <div>
          <div class="delvinta-eyebrow">Specialized Integration</div>

          <h2 class="delvinta-heading-small mt-4">Built around the laboratory.</h2>

          <p class="delvinta-body mt-5">
            Our focus is the integration layer where laboratory systems, instruments, middleware, and automation come
            together.
          </p>
        </div>

        <div class="divide-y divide-[var(--delvinta-border)] border-y border-[var(--delvinta-border)]">
          <div class="py-6">
            <div class="text-lg font-semibold text-[var(--delvinta-navy)]">Instrument Integration</div>

            <p class="mt-2 text-sm leading-6 text-[var(--delvinta-slate)]">
              Interface diagnostic instruments and laboratory systems through the appropriate middleware and integration
              architecture.
            </p>
          </div>

          <div class="py-6">
            <div class="text-lg font-semibold text-[var(--delvinta-navy)]">Automation & Middleware</div>

            <p class="mt-2 text-sm leading-6 text-[var(--delvinta-slate)]">
              Support laboratory automation lines and vendor middleware as part of broader laboratory integration
              initiatives.
            </p>
          </div>

          <div class="py-6">
            <div class="text-lg font-semibold text-[var(--delvinta-navy)]">Quality Control Integration</div>

            <p class="mt-2 text-sm leading-6 text-[var(--delvinta-slate)]">
              Integrate quality control workflows and systems into the laboratory environment.
            </p>
          </div>

          <div class="py-6">
            <div class="text-lg font-semibold text-[var(--delvinta-navy)]">Workflow Optimization</div>

            <p class="mt-2 text-sm leading-6 text-[var(--delvinta-slate)]">
              Improve laboratory efficiency through thoughtful interface design, autoverification, monitoring, and
              ongoing optimization.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TECHNICAL CENTERPIECE -->
  <section class="pb-20 md:pb-24">
    <div class="delvinta-container">
      <div class="delvinta-cta px-6 py-12 sm:px-10 md:px-14 md:py-16">
        <div class="relative z-10 grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
          <div>
            <div class="delvinta-kicker">The DELVINTA Integration Layer</div>

            <h2 class="mt-4 max-w-2xl text-3xl font-bold leading-tight tracking-tight text-white md:text-4xl">
              Connecting the systems that keep the laboratory moving.
            </h2>

            <p class="mt-5 max-w-xl text-base leading-7 text-white/65">
              From clinical systems to middleware, instruments, and automation, DELVINTA brings the integration layer
              together.
            </p>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-xl border border-white/10 bg-white/[0.06] p-5">
              <div class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-white/45">Clinical System</div>
              <div class="mt-2 text-lg font-semibold text-white">Epic Beaker</div>
            </div>

            <div class="rounded-xl border border-white/10 bg-white/[0.06] p-5">
              <div class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-white/45">Middleware</div>
              <div class="mt-2 text-lg font-semibold text-white">Data Innovations</div>
            </div>

            <div class="rounded-xl border border-white/10 bg-white/[0.06] p-5">
              <div class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-white/45">Diagnostics</div>
              <div class="mt-2 text-lg font-semibold text-white">Medical Instruments</div>
            </div>

            <div class="rounded-xl border border-white/10 bg-white/[0.06] p-5">
              <div class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-white/45">Automation</div>
              <div class="mt-2 text-lg font-semibold text-white">Laboratory Automation</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="delvinta-section border-t border-[var(--delvinta-border)]">
    <div class="delvinta-container">
      <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <div class="delvinta-eyebrow">Let&apos;s Talk</div>

          <h2 class="delvinta-heading-small mt-4">Have a laboratory integration challenge?</h2>

          <p class="delvinta-body mt-5">Implementation. Integration. Support. Optimization.</p>
        </div>

        <div>
          <a href="mailto:hello@delvinta.com" class="delvinta-button delvinta-button-primary"> Talk to DELVINTA </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
